#---------------------------------------------------------------------
#
# Dockerfile for the OpenAirInterface AUSF service
#   Valid for CentOS Stream 10
#
#---------------------------------------------------------------------

#---------------------------------------------------------------------
# BUILDER IMAGE
#---------------------------------------------------------------------

FROM quay.io/centos/centos:stream10 AS oai-ausf-builder

ENV IS_DOCKERFILE=1

# meson and ninja-build come from CRB; libidn-devel comes from EPEL.
# The other build_ausf dependencies are in BaseOS/AppStream.
RUN dnf config-manager --set-enabled crb && \
    dnf install epel-release -y && \
    dnf update -y && \
    # Log the exact OS release used for the build.
    cat /etc/os-release && \
    dnf install -y \
        psmisc \
        git \
        diffutils \
        libasan \
        wget \
        file && \
    # Libraries built from source are installed under /usr/local, which is not
    # on the default loader path on EL. This is also needed for the ldd check.
    echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf && \
    echo "/usr/local/lib64" >> /etc/ld.so.conf.d/local-lib.conf

# Git configuration
RUN git config --global https.postBuffer 123289600 && \
    git config --global http.sslverify false

# Copy source code
WORKDIR /openair-ausf
COPY . /openair-ausf

# Install and Build AUSF
WORKDIR /openair-ausf/build/scripts
RUN ./build_ausf --install-deps --force
RUN ./build_ausf --clean --Verbose --build-type Release --jobs && \
    ldd /openair-ausf/build/ausf/build/ausf && \
    mv /openair-ausf/build/ausf/build/ausf /openair-ausf/build/ausf/build/oai_ausf

FROM mikefarah/yq:latest AS yq-source

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM quay.io/centos/centos:stream10-minimal AS oai-ausf
ENV TZ=Europe/Paris

RUN microdnf update -y && \
    microdnf install -y \
# Timezone data, and debugging/networking utilities
      tzdata \
      procps-ng \
      psmisc \
      net-tools \
      iputils \
      tcpdump \
# Runtime dependencies of oai_ausf
      libicu \
      boost \
      libevent \
      nettle \
      gmp \
      findutils && \
    microdnf clean all -y && \
    rm -rf /var/cache/yum /var/cache/dnf

# Copy executable and generated libraries
WORKDIR /openair-ausf/bin
COPY --from=oai-ausf-builder \
    /openair-ausf/build/ausf/build/oai_ausf \
    /openair-ausf/scripts/healthcheck.sh \
    ./
COPY --from=yq-source /usr/bin/yq /usr/bin

# Only the libraries built from source; the rest come from the packages above.
# pistache (meson) and nghttp2 (autotools) install into lib, the CMake-built
# spdlog, fmt, yaml-cpp and cpr into lib64.
COPY --from=oai-ausf-builder \
    /usr/local/lib/libpistache.so* \
    /usr/local/lib/libnghttp2_asio.so \
    /usr/local/lib/libnghttp2_asio.so.1 \
    /usr/local/lib64/libspdlog.so \
    /usr/local/lib64/libfmt.so \
    /usr/local/lib64/libyaml-cpp.so.0.* \
    /usr/local/lib64/libcpr.so.1* \
    /usr/lib64/

RUN ldconfig && \
    ldd /openair-ausf/bin/oai_ausf && \
    # ldd exits 0 even when a library is missing, so check its output
    ! ldd /openair-ausf/bin/oai_ausf | grep -q 'not found'

WORKDIR /openair-ausf/etc
COPY --from=oai-ausf-builder \
    /openair-ausf/etc/config.yaml ./

WORKDIR /openair-ausf

# Expose ports
EXPOSE 80/tcp

# Configure healthcheck
HEALTHCHECK --interval=10s \
            --timeout=15s \
            --retries=6 \
    CMD /openair-ausf/bin/healthcheck.sh

CMD ["/openair-ausf/bin/oai_ausf", "-c" , "/openair-ausf/etc/config.yaml", "-o"]
